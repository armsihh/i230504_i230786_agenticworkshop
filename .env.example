# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Postgres (Neon, us-east-1). Leave empty for a local SQLite file + in-memory chat memory.
DATABASE_URL=
# Admin dashboard password (X-Admin-Password header)
ADMIN_PASSWORD=
# Signs website sessions and creative links. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Comma-separated website origins allowed by CORS, e.g. https://doubleaads.vercel.app
ALLOWED_ORIGINS=*
# Safety net for the $2 key: /chat pauses for the day once this much is spent
DAILY_BUDGET_USD=0.50
CHAT_RATE_PER_MIN=20
# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=doubleaads
